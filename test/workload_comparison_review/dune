(executable
 (name probe)
 (modules probe)
 (libraries hardcaml_asic.execution yojson))

(rule
 (targets fence.so)
 (deps fence.c)
 (action (run cc -shared -fPIC -o %{targets} %{dep:fence.c} -ldl)))

(rule
 (alias historical_review)
 (deps review.py ../workload_comparison/check.py ../check_resource_evidence.py fence.so)
 (action (run python3 -B %{dep:review.py}
   --probe %{exe:probe.exe} --variant %{exe:../workload_result/consumer.exe}
   --fence %{dep:fence.so})))

(alias
 (name runtest)
 (deps (alias corrected_review)))

(rule
 (alias corrected_review)
 (deps corrected_review.py review.py ../workload_comparison/check.py
   ../check_resource_evidence.py fence.so)
 (action (run python3 -B %{dep:corrected_review.py}
   --probe %{exe:probe.exe} --variant %{exe:../workload_result/consumer.exe}
   --fence %{dep:fence.so})))

