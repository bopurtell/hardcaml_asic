module Posix = Unix
open Core
open Hardcaml_asic

let checked = Or_error.ok_exn
let print json = print_endline (Yojson.Safe.to_string json)

(* Silver runs this CLI in the enclosing project root. Catalog discovery does
   not build targets. Flow dispatch uses an already-built target, preserving the
   root for relative source paths. A forwarded request cannot be forwarded again. *)
let target_catalog () =
  if Stdlib.Sys.file_exists Chip_catalog.filename
  then Some (Chip_catalog.load Chip_catalog.filename |> checked)
  else None

let chip_list () =
  let default, ids = match target_catalog () with
    | None -> Chip.target_id, [Chip.target_id]
    | Some c -> Chip_catalog.default_target c, List.map (Chip_catalog.entries c) ~f:(fun e -> e.id)
  in
  let variant = `Assoc ["id", `String "default"; "label", `String "Default"] in
  let chip id = `Assoc ["id", `String id; "label", `String id; "default_variant", `String "default";
                         "variants", `List [variant]] in
  print (`Assoc ["schema_version", `Int 1; "default_chip", `String default;
                 "chips", `List (List.map ids ~f:chip)])

let catalog = Generated.create ~default_flow:"standard"
    ~default_profile:"balanced" |> checked

let flow command args =
  let values = String.Table.create () in
  let keys = ["--chip"; "--variant"] @ (match command with
    | "list" -> []
    | "describe" -> ["--flow"]
    | "plan" | "emit" -> ["--flow"; "--profile"; "--endpoint"; "--source-root"]
      @ (if String.equal command "emit" then ["--results-root"; "--expected-plan-identity"] else [])
    | _ -> failwith "Expected flow list, describe, plan or emit") in
  let rec parse = function
    | [] -> ()
    | "--json" :: rest -> parse rest
    | k :: v :: rest when List.mem keys k ~equal:String.equal && not (String.is_prefix v ~prefix:"--") ->
      Hashtbl.add_exn values ~key:k ~data:v; parse rest
    | _ -> failwith "Unknown or incomplete flow option"
  in
  parse args;
  let get k = Hashtbl.find values k in
  let require k v = Option.iter (get k) ~f:(fun s ->
    if not (String.equal s v) then failwith ("Unknown selection: " ^ s)) in
  (match get "--chip" with
   | Some id when not (String.equal id Chip.target_id) ->
     if Option.is_some (Sys.getenv "HARDCAML_ASIC_FORWARDED_TARGET")
     then failwith "Catalog executable does not declare the selected chip target";
     let c = target_catalog () |> Option.value_exn ~message:"No chip target catalog" in
     let entry = Chip_catalog.select c ~id:(Some id) |> checked in
     (* Our generated CLI lives at CONTEXT/asic_NAME/project.exe. Stay in
        that same build context, including a custom --build-dir. *)
     let context = Posix.realpath Stdlib.Sys.executable_name |> Filename.dirname |> Filename.dirname in
     let path = Filename.concat context entry.executable in
     if not (Stdlib.Sys.file_exists path)
     then failwith ("Build the selected chip target: dune build " ^ entry.executable);
     let env = Array.append (Posix.environment ()) [|"HARDCAML_ASIC_FORWARDED_TARGET=" ^ id|] in
     Posix.execve path (Array.of_list (path :: "flow" :: command :: args)) env
   | _ -> ());
  require "--chip" Chip.target_id;
  require "--variant" "default";
  match command with
  | "list" -> print (Flow_spec.list_to_yojson catalog)
  | "describe" ->
    let id = Hashtbl.find_exn values "--flow" in
    let entry = Flow.Catalog.entries catalog |> List.find ~f:(fun e ->
      String.equal (Flow.Selection.Id.to_string (Flow.Methodology.id (Flow.Catalog.Entry.methodology e))) id)
      |> Option.value_exn ~message:("Unknown flow ID " ^ id) in
    print (Flow_spec.describe_to_yojson entry)
  | _ ->
    let selection = Flow.Selection.create ?flow:(get "--flow") ?profile:(get "--profile") () |> checked in
    let endpoint = Hashtbl.find_exn values "--endpoint" |> Flow.Stage.of_string |> checked in
    let request = Flow.Parameter.check_assignments ~configurable:[] [] |> checked in
    let source_root = Option.value (get "--source-root") ~default:(Sys_unix.getcwd ()) in
    let prepared = Methodology_plan.prepare ~catalog ~selection ~endpoint ~request ~catalog_inputs:Generated.source_inputs
      ?expected_plan_identity:(get "--expected-plan-identity") Chip.chip_target ~source_root |> checked in
    let plan = Methodology_plan.Prepared.plan prepared in
    if String.equal command "plan" then print (Methodology_plan.to_yojson plan)
    else (
      let results = Option.value (get "--results-root") ~default:(Filename.concat source_root "_flow_results") in
      let bundle = Methodology_plan.Prepared.bundle prepared in
      let publication = Bundle.publish bundle ~store_dir:(Filename.concat results "bundles") |> checked in
      print (`Assoc ["schema_version", `Int 1; "kind", `String "bundle_emission";
        "bundle_identity", `String (Bundle.identity bundle); "plan_identity", `String (Methodology_plan.plan_identity plan);
        "output_dir", `String publication.directory; "reused", `Bool publication.reused;
        "plan", Methodology_plan.to_yojson plan]))

let () =
  match Array.to_list (Sys.get_argv ()) with
  | [_; "chip"; "list"; "--json"] -> chip_list ()
  | _ :: "flow" :: command :: args -> flow command args
  | _ -> failwith "Expected chip list --json or flow list|describe|plan|emit"
